# Model: tiny, base, small, medium, large-v3, large-v3-turbo ...
WHISPER_MODEL=large-v3-turbo
WHISPER_COMPUTE_TYPE=int8
# Threads per replica. Replicas x threads should not pass the machine's cores.
WHISPER_CPU_THREADS=4
# Empty: Whisper detects the language of each recording.
WHISPER_LANGUAGE=id
# Lower beam is faster and a little less accurate; measure on your audio.
WHISPER_BEAM_SIZE=5
WHISPER_BEST_OF=5
# Comma separated words Whisper should lean towards.
HOTWORDS=

# Empty: no authentication. Otherwise clients send X-Api-Key.
API_KEY=

MAX_AUDIO_SIZE_MB=1000
# Jobs waiting per replica (they hold their audio in memory).
ASR_MAX_PENDING=30
# A job running longer than this is taken as hung and the process exits.
ASR_JOB_TIMEOUT_MINUTES=60
SYNC_MAX_WAIT_SECONDS=1800

# docker compose
ASR_REPLICAS=1
# The one port clients use (the nginx gateway).
ASR_PORT=7890
