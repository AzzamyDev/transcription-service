{
  "openapi": "3.0.0",
  "info": {
    "title": "Speech-to-text API",
    "description": "Transcribes audio with faster-whisper on the CPU. Work is queued and run one job at a time per process; scale out with replicas. When the service sets API_KEY, send it as the X-Api-Key header (/ping, /health and /docs stay open). Audio is processed in memory and never stored.",
    "version": "3.0.0"
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {"type": "apiKey", "in": "header", "name": "X-Api-Key"}
    },
    "schemas": {
      "Segment": {
        "type": "object",
        "properties": {
          "speaker": {"type": "string", "nullable": true, "description": "The track's label; null for an unlabelled file"},
          "start": {"type": "number", "description": "Seconds on the common timeline"},
          "end": {"type": "number"},
          "duration": {"type": "number"},
          "text": {"type": "string"},
          "confidence": {"type": "number", "description": "0-1, from Whisper's word probabilities"}
        }
      },
      "Result": {
        "type": "object",
        "properties": {
          "transcript": {"type": "string", "description": "One line per turn: \"LABEL: text\", or only the text without labels"},
          "segments": {"type": "array", "items": {"$ref": "#/components/schemas/Segment"}},
          "language": {"type": "string", "nullable": true},
          "audio_info": {"type": "object", "properties": {"duration_seconds": {"type": "number"}, "sample_rate": {"type": "integer"}}},
          "statistics": {"type": "object", "properties": {"total_words": {"type": "integer"}, "speech_seconds": {"type": "number"}, "speakers": {"type": "object"}}},
          "timings": {"type": "object", "properties": {"decoding": {"type": "number"}, "transcription": {"type": "number"}, "total": {"type": "number"}}}
        }
      },
      "Job": {
        "type": "object",
        "properties": {
          "job_id": {"type": "string"},
          "job_key": {"type": "string", "nullable": true},
          "status": {"type": "string", "enum": ["queued", "processing", "done", "failed"]},
          "position": {"type": "integer", "description": "Jobs ahead of a queued one"},
          "created_at": {"type": "number"},
          "started_at": {"type": "number", "nullable": true},
          "finished_at": {"type": "number", "nullable": true},
          "result": {"$ref": "#/components/schemas/Result"},
          "error": {"type": "string"}
        }
      },
      "AudioForm": {
        "type": "object",
        "properties": {
          "file": {"type": "string", "format": "binary", "description": "One recording. Use this or tracks."},
          "label": {"type": "string", "description": "Speaker label for file; omit for plain text"},
          "tracks": {"type": "array", "items": {"type": "string", "format": "binary"}, "description": "One recording per speaker"},
          "labels": {"type": "array", "items": {"type": "string"}, "description": "One per track"},
          "offsets": {"type": "array", "items": {"type": "number"}, "description": "Seconds from the start of the timeline at which each track starts"},
          "language": {"type": "string", "description": "Language code such as id or en; defaults to the service's WHISPER_LANGUAGE"}
        }
      }
    }
  },
  "security": [{"ApiKey": []}],
  "paths": {
    "/ping": {"get": {"summary": "Liveness", "security": [], "responses": {"200": {"description": "Alive"}}}},
    "/health": {"get": {"summary": "Ready once the model is loaded", "security": [], "responses": {"200": {"description": "Healthy"}, "503": {"description": "Model still loading"}}}},
    "/jobs": {
      "post": {
        "summary": "Queue a transcription",
        "description": "Answers at once. Sending the same job_key again returns the job already queued, running or done for it.",
        "requestBody": {"content": {"multipart/form-data": {"schema": {"allOf": [{"$ref": "#/components/schemas/AudioForm"}, {"type": "object", "properties": {"job_key": {"type": "string"}}}]}}}},
        "responses": {
          "202": {"description": "Queued", "content": {"application/json": {"schema": {"type": "object", "properties": {"success": {"type": "boolean"}, "data": {"$ref": "#/components/schemas/Job"}}}}}},
          "400": {"description": "Invalid request"},
          "401": {"description": "Missing or wrong X-Api-Key"},
          "503": {"description": "Queue full or model loading"}
        }
      }
    },
    "/jobs/{id}": {
      "get": {
        "summary": "Job status and result",
        "description": "Finished jobs are kept for 24 hours and are lost when the service restarts; a 404 means resubmit.",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "The job", "content": {"application/json": {"schema": {"type": "object", "properties": {"success": {"type": "boolean"}, "data": {"$ref": "#/components/schemas/Job"}}}}}}, "404": {"description": "Unknown job"}}
      }
    },
    "/transcribe": {
      "post": {
        "summary": "Transcribe and wait for the result",
        "description": "Queued like /jobs; answers 504 with a job id to poll if it takes longer than SYNC_MAX_WAIT_SECONDS. Meant for short audio.",
        "requestBody": {"content": {"multipart/form-data": {"schema": {"$ref": "#/components/schemas/AudioForm"}}}},
        "responses": {"200": {"description": "Transcribed", "content": {"application/json": {"schema": {"type": "object", "properties": {"success": {"type": "boolean"}, "data": {"$ref": "#/components/schemas/Result"}}}}}}, "400": {"description": "Invalid request"}, "500": {"description": "Transcription failed"}, "503": {"description": "Too many waiting requests, queue full or model loading"}, "504": {"description": "Still processing"}}
      }
    }
  }
}
