# One address in front of all replicas. The nginx image fills in the
# ${...} variables below from its environment when it starts.

# Docker's DNS: `asr` answers with every replica, and each replica also
# answers to its container id. Names are looked up again every few seconds,
# so a restarted replica is found without restarting nginx.
resolver 127.0.0.11 valid=5s ipv6=off;

# New jobs go to the replicas in turn.
upstream replicas {
    zone replicas 64k;
    server asr:8000 resolve;
}

server {
    listen 80;
    client_max_body_size ${MAX_AUDIO_SIZE_MB}m;
    client_body_timeout 300s;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # /transcribe holds the connection until the transcript is ready.
    proxy_read_timeout ${SYNC_MAX_WAIT_SECONDS}s;
    proxy_send_timeout 300s;

    # A job lives in the memory of the replica that took it, and its id starts
    # with that replica's container id (see REPLICA_ID): polls go back there.
    location ~ "^/jobs/(?<replica>[A-Za-z0-9]{1,12})-[0-9a-f]{32}$" {
        proxy_pass http://$replica:8000;
    }

    location / {
        proxy_pass http://replicas;
    }
}
